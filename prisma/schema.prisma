// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  // basic information (login only)
  id            String        @id @default(uuid())
  userId        String        @unique
  email         String        @unique
  password      String
  // role
  isAdmin       Boolean       @default(false)
  isBanned      Boolean       @default(false)
  // points system
  points        Int           @default(1000)
  virtual_score Decimal       @default(1000) // Added for betting system
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // relationships
  profile       Profile?
  posts         Post[]
  comments      Comment[]
  likedPosts    PostLike[]
  likedComments CommentLike[]
  bets          BettingLog[]
  followedBy    Follows[]     @relation("following")
  following     Follows[]     @relation("follower")
}

model Follows {
  follower    User     @relation("follower", fields: [followerId], references: [userId])
  followerId  String
  following   User     @relation("following", fields: [followingId], references: [userId])
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Category {
  // basic information
  id           String    @id @default(uuid())
  name         String    @unique
  slug         String?   @unique
  description  String?
  displayOrder Int       @default(1) // 表示順序 / Display order
  // timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // ソフトデリート用のタイムスタンプ / Soft delete timestamp
  // relationships
  posts        Post[]

  @@index([deletedAt]) // クエリパフォーマンス向上のためのインデックス / Index for query performance
  @@index([displayOrder]) // ソートパフォーマンス向上のためのインデックス / Index for sort performance
}

model Post {
  // basic information
  id         String     @id
  title      String
  content    String
  userId     String
  tags       String[]
  categoryId String? // カテゴリID（オプション） / Category ID (optional)
  eventId    String? // 関連するイベントID / Related Event ID
  // statistics
  views      Int        @default(0)
  likes      Int        @default(0)
  // timestamps
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime? // ソフトデリート用のタイムスタンプ / Soft delete timestamp
  // relationships
  user       User       @relation(fields: [userId], references: [userId])
  category   Category?  @relation(fields: [categoryId], references: [id])
  event      Event?     @relation(fields: [eventId], references: [id])
  comments   Comment[]
  likedBy    PostLike[]

  @@index([deletedAt]) // クエリパフォーマンス向上のためのインデックス / Index for query performance
  @@index([categoryId]) // カテゴリクエリパフォーマンス向上のためのインデックス / Index for category query performance
}

model Comment {
  // basic information
  id        String        @id
  content   String
  userId    String
  postId    String
  parentId  String?
  // statistics
  likes     Int           @default(0)
  replies   Int           @default(0)
  // timestamps
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime? // ソフトデリート用のタイムスタンプ / Soft delete timestamp
  // relationships
  user      User          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  likedBy   CommentLike[]
}

model PostLike {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  // relationships
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  // relationships
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

model Profile {
  // basic information
  id          String    @id @default(uuid())
  userId      String    @unique
  name        String
  nickname    String?
  gender      String?
  birthDate   DateTime?
  avatar      String?
  // additional fields
  height      Int?
  weight      Int?
  description String?
  record      String?
  train_start Int?
  stance      String?
  gym         String?
  // visibility settings (JSON format: { "name": "public", "nickname": "friends", ... })
  visibility  Json      @default("{}")
  // soft delete
  deletedAt   DateTime?
  // timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // relationships
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
}

model Event {
  id                 String      @id
  name               String
  fight_date         DateTime //賽事日期
  status             EventStatus @default(PENDING) //賽事狀態
  fighter_1_id       String  //賽事參賽者1ID
  fighter_2_id       String  //賽事參賽者2ID
  winner_id          String? //賽事勝者ID
  win_method         String? //賽事勝利方式
  win_round          Int?    //賽事勝利回合
  is_manual_override Boolean     @default(false) //是否已由管理員手動覆蓋賽果
  // External API integration fields
  external_id        String? //外部APIのイベントID / External API event ID
  external_source    String? //データソース（例: "thesportsdb"） / Data source (e.g. "thesportsdb")
  external_data      Json?   //元のAPIデータスナップショット / Original API data snapshot
  sport_type         String? //スポーツタイプ（"boxing", "ufc", "mma"） / Sport type
  last_synced_at     DateTime?//最後の同期時刻 / Last sync timestamp
  sync_status        String      @default("pending") // 同期ステータス / Sync status
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  posts Post[]
  bets  BettingLog[]
  fighterEvents FighterEvent[]

  @@unique([external_id, external_source]) // 外部イベントの一意制約 / Unique constraint for external events
  @@index([external_id, external_source]) // 外部イベントの高速検索 / Fast lookup for external events
  @@index([fight_date, status]) // 今週のイベントクエリの最適化 / Optimize weekly events query
  @@index([last_synced_at]) // 増分同期クエリの最適化 / Optimize incremental sync query
  @@index([sport_type, fight_date]) // イベント分析ページのクエリ最適化（将来の拡張） / Optimize event analysis page query (future expansion)
}

enum EventStatus {
  PENDING
  OPEN
  CLOSED
  SETTLED
  CANCELLED
}

model BettingLog {
  id                String    @id @default(uuid()) //主鍵
  userId            String //用戶ID
  eventId           String //賽事ID
  bet_amount        Decimal //投注總金額
  target_winner_id  String //投注目標勝者ID
  odds_snapshot     Decimal //投注時的即時賠率快照(用於未來爭議或審計)
  is_winning_bet    Boolean @default(false) //是否中獎投注
  final_payout      Decimal? //最終支付金額
  settlement_status BetStatus @default(PENDING) //結算狀態
  createdAt         DateTime  @default(now()) //創建時間

  user  User  @relation(fields: [userId], references: [userId])
  event Event @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String //管理員ID
  action_type String //操作類型
  description String //描述
  ip_address  String //IP位址
  createdAt   DateTime @default(now()) //操作時間
}

model Fighter {
  id               String    @id @default(uuid())
  slug             String    @unique // URL-friendly slug (e.g., "conor-mcgregor")
  name             String    // Full name
  external_id      String?   // TheSportsDB API idPlayer
  external_source  String?   @default("thesportsdb") // Data source
  external_data    Json?     // Complete API response cache
  sport_type       String?   // boxing/ufc/mma
  nationality      String?
  date_born        DateTime?
  height           String?   // Height (e.g., "5 ft 9 in")
  weight           String?   // Weight (e.g., "155 lbs")
  position         String?   // Weight class/position
  description      String?   // Biography/description
  thumb            String?   // Profile thumbnail URL
  cutout           String?   // Cutout image URL
  last_synced_at   DateTime? // Last sync timestamp
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relationships
  eventsAsFighter  FighterEvent[] @relation("Fighter")
  eventsAsOpponent FighterEvent[] @relation("Opponent")

  @@index([external_id, external_source]) // Fast lookup for external fighters
  @@index([sport_type]) // Filter by sport type
  @@index([slug]) // Fast slug lookup
}

model FighterEvent {
  id           String    @id @default(uuid())
  fighter_id   String    // FK to Fighter
  event_id     String    // FK to Event
  opponent_id  String?   // FK to Fighter (opponent)
  result       String?   // Win/Loss/Draw/NC (No Contest)
  method       String?   // KO/TKO/Decision/Submission/etc.
  round        Int?      // Round number
  time         String?   // Time in round
  weight_class String?   // Weight class for this fight
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  fighter  Fighter @relation("Fighter", fields: [fighter_id], references: [id], onDelete: Cascade)
  opponent Fighter? @relation("Opponent", fields: [opponent_id], references: [id], onDelete: SetNull)
  event    Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([fighter_id, event_id]) // One fighter can only appear once per event
  @@index([fighter_id]) // Fast lookup by fighter
  @@index([event_id]) // Fast lookup by event
  @@index([opponent_id]) // Fast lookup by opponent
}
