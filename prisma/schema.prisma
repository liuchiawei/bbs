// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // basic information (login only)
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String   @unique
  password  String
  // role
  isAdmin   Boolean  @default(false)
  isBanned  Boolean  @default(false)
  // points system
  points    Int      @default(1000)
  virtual_score Decimal @default(1000) // Added for betting system
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // relationships
  profile   Profile?
  posts     Post[]
  comments  Comment[]
  likedPosts PostLike[]
  likedComments CommentLike[]
  bets      BettingLog[]
}

model Category {
  // basic information
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String?  @unique
  description  String?
  displayOrder Int      @default(1) // 表示順序 / Display order
  // timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // ソフトデリート用のタイムスタンプ / Soft delete timestamp
  // relationships
  posts        Post[]

  @@index([deletedAt]) // クエリパフォーマンス向上のためのインデックス / Index for query performance
  @@index([displayOrder]) // ソートパフォーマンス向上のためのインデックス / Index for sort performance
}

model Post {
  // basic information
  id         String   @id @default(uuid())
  title      String
  content    String
  userId     String
  tags       String[]
  categoryId String?  // カテゴリID（オプション） / Category ID (optional)
  eventId    String?  // 関連するイベントID / Related Event ID
  // statistics
  views      Int      @default(0)
  likes      Int      @default(0)
  // timestamps
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // ソフトデリート用のタイムスタンプ / Soft delete timestamp
  // relationships
  user       User     @relation(fields: [userId], references: [userId])
  category   Category? @relation(fields: [categoryId], references: [id])
  event      Event?   @relation(fields: [eventId], references: [id])
  comments   Comment[]
  likedBy    PostLike[]

  @@index([deletedAt]) // クエリパフォーマンス向上のためのインデックス / Index for query performance
  @@index([categoryId]) // カテゴリクエリパフォーマンス向上のためのインデックス / Index for category query performance
}

model Comment {
  // basic information
  id        String   @id @default(uuid())
  content   String
  userId    String
  postId    String
  parentId  String?
  // statistics
  likes     Int      @default(0)
  replies   Int      @default(0)
  // timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // ソフトデリート用のタイムスタンプ / Soft delete timestamp
  // relationships
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  likedBy CommentLike[]
}

model PostLike {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  // relationships
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  // relationships
  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

model Profile {
  // basic information
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  nickname  String?
  gender    String?
  birthDate DateTime?
  avatar    String?
  // additional fields
  height    Int?
  weight    Int?
  description String?
  record    String?
  train_start Int?
  stance    String?
  gym       String?
  // visibility settings (JSON format: { "name": "public", "nickname": "friends", ... })
  visibility Json    @default("{}")
  // soft delete
  deletedAt DateTime?
  // timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // relationships
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
}

model Event {
  id               String      @id @default(uuid())
  name             String
  fight_date       DateTime
  status           EventStatus @default(PENDING)
  winner_id        String?
  is_manual_override Boolean   @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  posts            Post[]
  bets             BettingLog[]
}

enum EventStatus {
  PENDING
  OPEN
  CLOSED
  SETTLED
  CANCELLED
}

model BettingLog {
  id               String    @id @default(uuid())
  userId           String
  eventId          String
  bet_amount       Decimal
  target_winner_id String
  odds_snapshot    Decimal
  final_payout     Decimal?
  settlement_status BetStatus @default(PENDING)
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [userId])
  event            Event     @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  action_type String
  description String
  createdAt   DateTime @default(now())
}